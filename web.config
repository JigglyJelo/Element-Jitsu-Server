<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 1) Turn WebSockets ON so that Socket.IO can do wss:// upgrades -->
    <webSocket enabled="true" />

    <!-- 2) Tell IISNode to run dist/src/index.js for all non‐static requests -->
    <handlers>
      <add name="iisnode" path="dist/src/index.js" verb="*" modules="iisnode"/>
    </handlers>

    <!-- 3) Rewrite rules: 
           • If the request maps to an existing file on disk, do nothing (serve it normally). 
           • Otherwise, rewrite everything to dist/src/index.js so that your Express app picks it up. 
    -->
    <rewrite>
      <rules>
        <!-- If the requested file exists (e.g. /socket.io/socket.io.js or a static .js/.css), serve it. -->
        <rule name="StaticContent" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- All other URLs (/, /socket.io/..., /api/…, etc.) get rewritten to dist/src/index.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="dist/src/index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 4) Let Node errors bubble through so you can see them in Log Stream -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
